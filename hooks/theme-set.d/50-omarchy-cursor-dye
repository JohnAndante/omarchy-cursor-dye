#!/bin/bash
# Installed by omarchy-cursor-dye into ~/.config/omarchy/hooks/theme-set.d/
#
# Omarchy runs this after every `omarchy theme set`, passing the new theme's
# snake-cased name as $1. Builds are cached per colour set, so a repeat theme
# costs nothing.

mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-cursor-dye"
exec >>"${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-cursor-dye/hook.log" 2>&1
echo "--- $(date -Is)  theme-set $1"

command -v omarchy-cursor-dye >/dev/null || {
  echo "omarchy-cursor-dye not on PATH; skipping"
  exit 0
}

# Deliberately not "sync $1". By now Omarchy has staged $1's colors.toml *and*
# shell.toml into ~/.local/state/omarchy/current/theme/, so plain `sync` reads
# the fully-merged state; naming the theme re-derives its palette from its source
# dir, which mostly ships no shell.toml, silently losing the bar colour. See
# palette() in bin/omarchy-cursor-dye.
#
# Backgrounded so the theme switch doesn't block on the rebuild.
omarchy-cursor-dye sync &
