{
  // Installed by omarchy-cursor-dye. Remove this file to remove the menu.
  "appearance.cursor-dye": {"icon":"󰇀","label":"Cursor Dye"},
  "appearance.cursor-dye.mode": {"icon":"󰔎","label":"Mode"},
  "appearance.cursor-dye.mode.follow": {"icon":"󰔎","label":"Follow Theme","checked":"omarchy-cursor-dye status --json | jq -e '.mode == \"follow\"' >/dev/null","action":"omarchy-cursor-dye set mode follow"},
  "appearance.cursor-dye.mode.fixed": {"icon":"󰏘","label":"Fixed Color...","checked":"omarchy-cursor-dye status --json | jq -e '.mode == \"fixed\"' >/dev/null","action":"color=$(omarchy-menu-input 'Fixed color (#rrggbb)') && omarchy-cursor-dye set fixed-color \"$color\""},
  "appearance.cursor-dye.mode.default": {"icon":"󰝤","label":"System Default","checked":"omarchy-cursor-dye status --json | jq -e '.mode == \"default\"' >/dev/null","action":"omarchy-cursor-dye set mode default"},
  "appearance.cursor-dye.preset": {"icon":"","label":"Preset"},
  "appearance.cursor-dye.preset.accent-fill": {"icon":"","label":"Accent Fill","checked":"omarchy-cursor-dye status --json | jq -e '.preset == \"accent-fill\"' >/dev/null","action":"omarchy-cursor-dye set preset accent-fill"},
  "appearance.cursor-dye.preset.accent-outline": {"icon":"","label":"Accent Outline","checked":"omarchy-cursor-dye status --json | jq -e '.preset == \"accent-outline\"' >/dev/null","action":"omarchy-cursor-dye set preset accent-outline"},
  "appearance.cursor-dye.preset.accent-fill-bar": {"icon":"","label":"Accent Fill + Bar","checked":"omarchy-cursor-dye status --json | jq -e '.preset == \"accent-fill-bar\"' >/dev/null","action":"omarchy-cursor-dye set preset accent-fill-bar"},
  "appearance.cursor-dye.preset.accent-outline-bar": {"icon":"","label":"Accent Outline + Bar","checked":"omarchy-cursor-dye status --json | jq -e '.preset == \"accent-outline-bar\"' >/dev/null","action":"omarchy-cursor-dye set preset accent-outline-bar"},
  "appearance.cursor-dye.preset.bar-fill": {"icon":"","label":"Bar Fill","checked":"omarchy-cursor-dye status --json | jq -e '.preset == \"bar-fill\"' >/dev/null","action":"omarchy-cursor-dye set preset bar-fill"},
  "appearance.cursor-dye.preset.bar-outline": {"icon":"","label":"Bar Outline","checked":"omarchy-cursor-dye status --json | jq -e '.preset == \"bar-outline\"' >/dev/null","action":"omarchy-cursor-dye set preset bar-outline"},
  "appearance.cursor-dye.size": {"icon":"","label":"Size"},
  "appearance.cursor-dye.size.16": {"icon":"󱎤","label":"16 px","checked":"omarchy-cursor-dye status --json | jq -e '.size == 16' >/dev/null","action":"omarchy-cursor-dye set size 16"},
  "appearance.cursor-dye.size.24": {"icon":"󱎥","label":"24 px","checked":"omarchy-cursor-dye status --json | jq -e '.size == 24' >/dev/null","action":"omarchy-cursor-dye set size 24"},
  "appearance.cursor-dye.size.32": {"icon":"󱎦","label":"32 px","checked":"omarchy-cursor-dye status --json | jq -e '.size == 32' >/dev/null","action":"omarchy-cursor-dye set size 32"},
  "appearance.cursor-dye.size.48": {"icon":"󱎧","label":"48 px","checked":"omarchy-cursor-dye status --json | jq -e '.size == 48' >/dev/null","action":"omarchy-cursor-dye set size 48"},
  "appearance.cursor-dye.style": {"icon":"","label":"Style"},
  "appearance.cursor-dye.style.modern": {"icon":"","label":"Modern","checked":"omarchy-cursor-dye status --json | jq -e '.style == \"modern\"' >/dev/null","action":"omarchy-cursor-dye set style modern"},
  "appearance.cursor-dye.style.original": {"icon":"󰆿","label":"Original","checked":"omarchy-cursor-dye status --json | jq -e '.style == \"original\"' >/dev/null","action":"omarchy-cursor-dye set style original"},
  "appearance.cursor-dye.style.modern-right": {"icon":"","label":"Modern Left-handed","checked":"omarchy-cursor-dye status --json | jq -e '.style == \"modern-right\"' >/dev/null","action":"omarchy-cursor-dye set style modern-right"},
  "appearance.cursor-dye.style.original-right": {"icon":"󰆿","label":"Original Left-handed","checked":"omarchy-cursor-dye status --json | jq -e '.style == \"original-right\"' >/dev/null","action":"omarchy-cursor-dye set style original-right"},
  "appearance.cursor-dye.sync": {"icon":"󰑐","label":"Sync Cursor","action":"omarchy-cursor-dye sync"},
  "appearance.cursor-dye.config": {"icon":"","label":"Open Configuration","action":"omarchy-cursor-dye config"}
}
